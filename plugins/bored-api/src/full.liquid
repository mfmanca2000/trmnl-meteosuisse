{% comment %}
  Full layout (800x480). Data comes from GET /api/bored-api/activity
  ({ activity, count, updatedAtLabel }), exposed at the Liquid root by
  TRMNL's polling strategy. `activity` is null when the type/participants
  filter matched nothing.
{% endcomment %}
<div class="layout">
  <div class="flex flex--col h--full w--full">
    {% if activity %}
    <div class="flex flex--col flex--center-x flex--center-y gap--medium grow">
      <div class="value value--large text--center">{{ activity.activity }}</div>

      <div class="flex flex--row gap--xsmall flex--wrap flex--center-x">
        {% if activity.type %}
        <span class="label label--small label--outline">{{ activity.type | capitalize }}</span>
        {% endif %}
        <span class="label label--small label--outline">{{ activity.participants }} participant{% if activity.participants != 1 %}s{% endif %}</span>
        <span class="label label--small label--outline">{{ activity.duration | capitalize }}</span>
        <span class="label label--small label--outline">{% if activity.price == 0 %}Free{% else %}Costs money{% endif %}</span>
        {% if activity.kidFriendly %}
        <span class="label label--small label--outline">Kid friendly</span>
        {% endif %}
      </div>

      {% if activity.accessibility %}
      <div class="description text--center">{{ activity.accessibility }}</div>
      {% endif %}

      {% if activity.link and activity.link != "" %}
      <div class="description text--center" style="word-break: break-all;">{{ activity.link }}</div>
      {% endif %}
    </div>
    {% else %}
    <div class="flex flex--col flex--center-x flex--center-y gap--medium grow">
      <div class="value value--large">&#129300;</div>
      <div class="title title--medium text--center">No matching activity</div>
      <div class="description text--center">Try loosening the type or participants filter.</div>
    </div>
    {% endif %}

    <div class="label label--small text--center text--gray-50">Copyright &copy; The App Brewery</div>
  </div>
</div>

<div class="title_bar">
  <span class="title">Bored?</span>
  <span class="instance">{% if count > 1 %}1 of {{ count }} matches &middot; {% endif %}Updated {{ updatedAtLabel }}</span>
</div>
