{% comment %}
  Half horizontal layout (800x240). Same data as full.liquid, trimmed for
  half the height: activity name, badges, no link/accessibility text.
{% endcomment %}
<div class="layout">
  <div class="flex flex--col h--full w--full">
    {% if activity %}
    <div class="flex flex--col flex--center-x flex--center-y gap--small grow">
      <div class="value value--base lg:value--large text--center">{{ activity.activity }}</div>

      <div class="flex flex--row gap--xsmall flex--wrap flex--center-x">
        {% if activity.type %}
        <span class="label label--small label--outline">{{ activity.type | capitalize }}</span>
        {% endif %}
        <span class="label label--small label--outline">{{ activity.participants }} participant{% if activity.participants != 1 %}s{% endif %}</span>
        <span class="label label--small label--outline">{{ activity.duration | capitalize }}</span>
        <span class="label label--small label--outline">{% if activity.price == 0 %}Free{% else %}Costs money{% endif %}</span>
      </div>
    </div>
    {% else %}
    <div class="flex flex--col flex--center-x flex--center-y gap--small grow">
      <div class="value value--base">&#129300;</div>
      <div class="description text--center">No matching activity</div>
    </div>
    {% endif %}

    <div class="label label--small text--center text--muted">Copyright &copy; The App Brewery</div>
  </div>
</div>

<div class="title_bar">
  <span class="title">Bored?</span>
  <span class="instance">{% if count > 1 %}1 of {{ count }} matches{% endif %}</span>
</div>
