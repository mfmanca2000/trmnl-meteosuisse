{% comment %}
  Quadrant layout (400x240). Tightest space: activity name, one line of
  badges, no accessibility text.
{% endcomment %}
<div class="layout">
  <div class="flex flex--col h--full w--full">
    {% if activity %}
    <div class="flex flex--col flex--center-x flex--center-y gap--xsmall text--center grow">
      <div class="title title--small lg:title--base" data-clamp="3">{{ activity.activity }}</div>
      <div class="flex flex--row gap--xsmall flex--wrap flex--center-x">
        <span class="label label--small label--outline">{{ activity.participants }}p</span>
        <span class="label label--small label--outline">{{ activity.duration | capitalize }}</span>
        <span class="label label--small label--outline">{% if activity.price == 0 %}Free{% else %}$$${% endif %}</span>
      </div>
    </div>
    {% else %}
    <div class="flex flex--col flex--center-x flex--center-y gap--xsmall grow">
      <div class="description text--center">No match</div>
    </div>
    {% endif %}

    <div class="label label--small text--center label--gray">Copyright &copy; The App Brewery</div>
  </div>
</div>

<div class="title_bar">
  <span class="title">Bored?</span>
</div>
