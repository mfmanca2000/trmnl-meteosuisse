{% comment %}
  Full layout (800x480). Data comes from GET /api/daily-saints/today
  ({ date, feastDay, count, saints: [...], updatedAtLabel }), exposed at the
  Liquid root by TRMNL's polling strategy. Only the principal saint (saints[0])
  is shown; the title bar notes how many others share the day.
{% endcomment %}
{% assign saint = saints[0] %}
<div class="layout">
  <div class="flex flex--col h--full w--full">
    {% if saint %}
    <div class="flex flex--row flex--center-x flex--center-y gap--large grow portrait:flex--col">
      {% if saint.image %}
      <img class="image image--cover image-dither rounded shrink-0 w--56 h--64" src="{{ saint.image }}">
      {% endif %}
      <div class="flex flex--col gap--small w--min-0 grow">
        <div>
          <div class="title title--large">{{ saint.name }}</div>
          <div class="label">{{ feastDay }}{% if saint.era %} &middot; {{ saint.era }}{% endif %}</div>
        </div>

        {% if saint.legacy %}
        <div class="description">&ldquo;{{ saint.legacy }}&rdquo;</div>
        {% endif %}

        <div class="divider"></div>

        {% if saint.summary %}
        <div class="description" data-clamp="6">{{ saint.summary }}</div>
        {% endif %}

        {% if saint.patronage and saint.patronage.size > 0 %}
        <div class="flex flex--row gap--xsmall flex--wrap">
          {% for p in saint.patronage %}
          <span class="label label--small label--outline">{{ p }}</span>
          {% endfor %}
        </div>
        {% endif %}
      </div>
    </div>
    {% else %}
    <div class="flex flex--col flex--center-x flex--center-y gap--medium grow">
      <div class="value value--large">&#128330;</div>
      <div class="title title--base text--center">No saint data</div>
      <div class="description text--center">Check the plugin's data files on the server.</div>
    </div>
    {% endif %}

    <div class="label label--small text--center text--muted">Saints data: github.com/ACoci86/daily-saints &middot; &copy; 2026 Alessio Coci</div>
  </div>
</div>

<div class="title_bar">
  <span class="title">Saint of the Day</span>
  <span class="instance">{% if count > 1 %}+{{ count | minus: 1 }} more today &middot; {% endif %}Updated {{ updatedAtLabel }}</span>
</div>
