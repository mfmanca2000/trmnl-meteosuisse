{% comment %}
  Full layout (800x480). Data comes from GET /api/daily-saints/today
  ({ date, feastDay, count, saints: [...], updatedAtLabel }), exposed at the
  Liquid root by TRMNL's polling strategy. Only the principal saint (saints[0])
  is shown; the title bar notes how many others share the day.
{% endcomment %}
{% assign saint = saints[0] %}
<div class="layout">
  {% if saint %}
  <div class="flex flex--row gap--large h--full">
    {% if saint.image %}
    <div class="flex flex--col flex--center-y" style="flex: 0 0 220px;">
      <img class="image" src="{{ saint.image }}" style="width: 220px; height: 260px; object-fit: cover; border-radius: 10px;">
    </div>
    {% endif %}
    <div class="flex flex--col gap--small" style="flex: 1; min-width: 0;">
      <div>
        <div class="title title--large">{{ saint.name }}</div>
        <div class="label">{{ feastDay }}{% if saint.era %} &middot; {{ saint.era }}{% endif %}</div>
      </div>

      {% if saint.legacy %}
      <div class="description" style="font-style: italic;">&ldquo;{{ saint.legacy }}&rdquo;</div>
      {% endif %}

      <div class="divider"></div>

      {% if saint.summary %}
      <div class="description" style="display: -webkit-box; -webkit-line-clamp: 6; -webkit-box-orient: vertical; overflow: hidden;">{{ saint.summary }}</div>
      {% endif %}

      {% if saint.patronage and saint.patronage.size > 0 %}
      <div class="flex flex--row gap--xsmall" style="flex-wrap: wrap; margin-top: auto;">
        {% for p in saint.patronage %}
        <span class="label label--small" style="border: 1px solid currentColor; border-radius: 12px; padding: 2px 10px;">{{ p }}</span>
        {% endfor %}
      </div>
      {% endif %}
    </div>
  </div>
  {% else %}
  <div class="flex flex--col flex--center-x flex--center-y gap--medium h--full">
    <div class="value value--large">&#128330;</div>
    <div class="title title--medium text--center">No saint data</div>
    <div class="description text--center">Check the plugin's data files on the server.</div>
  </div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">Saint of the Day</span>
  <span class="instance">{% if count > 1 %}+{{ count | minus: 1 }} more today &middot; {% endif %}Updated {{ updatedAtLabel }}</span>
</div>
