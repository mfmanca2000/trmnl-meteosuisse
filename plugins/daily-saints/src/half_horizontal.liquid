{% comment %}
  Half horizontal layout (800x240). Same data as full.liquid, trimmed for
  half the height: portrait, name/era, and a two-line summary clamp.
{% endcomment %}
{% assign saint = saints[0] %}
<div class="layout">
  <div class="flex flex--col h--full w--full">
    {% if saint %}
    <div class="flex flex--row flex--center-y gap--medium grow portrait:flex--col">
      {% if saint.image %}
      <img class="image image--cover image-dither rounded shrink-0 w--36 h--44" src="{{ saint.image }}">
      {% endif %}
      <div class="flex flex--col gap--xsmall grow w--min-0">
        <div>
          <div class="title title--base">{{ saint.name }}</div>
          <div class="label">{{ feastDay }}{% if saint.era %} &middot; {{ saint.era }}{% endif %}</div>
        </div>

        {% if saint.legacy %}
        <div class="description">&ldquo;{{ saint.legacy }}&rdquo;</div>
        {% endif %}

        {% if saint.summary %}
        <div class="description" data-clamp="3">{{ saint.summary }}</div>
        {% endif %}

        {% if saint.patronage and saint.patronage.size > 0 %}
        <div class="flex flex--row gap--xsmall flex--wrap">
          {% for p in saint.patronage limit: 4 %}
          <span class="label label--small label--outline">{{ p }}</span>
          {% endfor %}
        </div>
        {% endif %}
      </div>
    </div>
    {% else %}
    <div class="flex flex--col flex--center-x flex--center-y gap--small grow">
      <div class="value value--base">&#128330;</div>
      <div class="description text--center">No saint data</div>
    </div>
    {% endif %}

    <div class="label label--small text--center text--muted">Saints data: github.com/ACoci86/daily-saints &middot; &copy; 2026 Alessio Coci</div>
  </div>
</div>

<div class="title_bar">
  <span class="title">Saint of the Day</span>
  <span class="instance">{% if count > 1 %}+{{ count | minus: 1 }} more today{% endif %}</span>
</div>
