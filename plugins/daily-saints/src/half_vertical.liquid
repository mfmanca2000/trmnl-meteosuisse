{% comment %}
  Half vertical layout (400x480). Narrow column, so the portrait sits on top
  and the text stacks centered below it instead of side-by-side.
{% endcomment %}
{% assign saint = saints[0] %}
<div class="layout">
  <div class="flex flex--col h--full w--full">
    {% if saint %}
    <div class="flex flex--col flex--center-x gap--small grow">
      {% if saint.image %}
      <img class="image image--cover image-dither rounded w--[110px] h--32 lg:w--36 lg:h--40" src="{{ saint.image }}">
      {% endif %}

      <div class="text--center">
        <div class="title title--base">{{ saint.name }}</div>
        <div class="label">{{ feastDay }}{% if saint.era %} &middot; {{ saint.era }}{% endif %}</div>
      </div>

      {% if saint.legacy %}
      <div class="description text--center">&ldquo;{{ saint.legacy }}&rdquo;</div>
      {% endif %}

      <div class="divider"></div>

      {% if saint.summary %}
      <div class="description text--center" data-clamp="5">{{ saint.summary }}</div>
      {% endif %}

      {% if saint.patronage and saint.patronage.size > 0 %}
      <div class="flex flex--row gap--xsmall flex--wrap flex--center-x">
        {% for p in saint.patronage limit: 3 %}
        <span class="label label--small label--outline">{{ p }}</span>
        {% endfor %}
      </div>
      {% endif %}
    </div>
    {% else %}
    <div class="flex flex--col flex--center-x flex--center-y gap--small grow">
      <div class="value value--base">&#128330;</div>
      <div class="description text--center">No saint data</div>
    </div>
    {% endif %}

    <div class="label label--small text--center text--muted">github.com/ACoci86/daily-saints &middot; &copy; 2026 Alessio Coci</div>
  </div>
</div>

<div class="title_bar">
  <span class="title">Saint of the Day</span>
  <span class="instance">{% if count > 1 %}+{{ count | minus: 1 }} more{% endif %}</span>
</div>
