{% comment %}
  Quadrant layout (400x240). Tightest space: small portrait, name, feast day,
  and the one-line legacy phrase only — no summary, no patronage tags.
{% endcomment %}
{% assign saint = saints[0] %}
<div class="layout">
  {% if saint %}
  <div class="flex flex--row gap--small h--full" style="align-items: center;">
    {% if saint.image %}
    <img class="image" src="{{ saint.image }}" style="width: 90px; height: 110px; object-fit: cover; border-radius: 6px; flex: 0 0 auto;">
    {% endif %}
    <div class="flex flex--col gap--xsmall" style="min-width: 0;">
      <div class="title title--small">{{ saint.name }}</div>
      <div class="label label--small">{{ feastDay }}{% if saint.era %} &middot; {{ saint.era }}{% endif %}</div>
      {% if saint.legacy %}
      <div class="description" style="font-style: italic; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">&ldquo;{{ saint.legacy }}&rdquo;</div>
      {% endif %}
    </div>
  </div>
  {% else %}
  <div class="flex flex--col flex--center-x flex--center-y gap--xsmall h--full">
    <div class="value value--small">&#128330;</div>
    <div class="description text--center">No saint data</div>
  </div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">Saint of the Day</span>
</div>
