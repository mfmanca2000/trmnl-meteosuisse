{% comment %}
  Quadrant layout (400x240). Tightest space: small portrait, name, feast day,
  and the one-line legacy phrase only — no summary, no patronage tags.
{% endcomment %}
{% assign saint = saints[0] %}
<div class="layout">
  <div class="flex flex--col h--full w--full">
    {% if saint %}
    <div class="flex flex--row flex--center-y gap--small grow">
      {% if saint.image %}
      <img class="image image--cover rounded shrink-0" src="{{ saint.image }}" style="width: 90px; height: 110px;">
      {% endif %}
      <div class="flex flex--col gap--xsmall w--min-0">
        <div class="title title--small">{{ saint.name }}</div>
        <div class="label label--small">{{ feastDay }}{% if saint.era %} &middot; {{ saint.era }}{% endif %}</div>
        {% if saint.legacy %}
        <div class="description" style="font-style: italic;" data-clamp="2">&ldquo;{{ saint.legacy }}&rdquo;</div>
        {% endif %}
      </div>
    </div>
    {% else %}
    <div class="flex flex--col flex--center-x flex--center-y gap--xsmall grow">
      <div class="value value--small">&#128330;</div>
      <div class="description text--center">No saint data</div>
    </div>
    {% endif %}

    <div class="text--center text--gray-50" style="font-size: 8px; line-height: 1.2;">github.com/ACoci86/daily-saints &middot; &copy; 2026 Alessio Coci</div>
  </div>
</div>

<div class="title_bar">
  <span class="title">Saint of the Day</span>
</div>
