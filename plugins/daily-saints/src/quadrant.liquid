{% comment %}
  Quadrant layout (400x240). Tightest space: small portrait, name, feast day,
  and the one-line legacy phrase only — no summary, no patronage tags.
{% endcomment %}
{% assign saint = saints[0] %}
<div class="layout">
  <div class="flex flex--col h--full w--full">
    {% if saint %}
    <div class="flex flex--row flex--center-y gap--small grow portrait:flex--col">
      {% if saint.image %}
      <img class="image image--cover image-dither rounded shrink-0 w--[90px] h--[110px]" src="{{ saint.image }}">
      {% endif %}
      <div class="flex flex--col gap--xsmall w--min-0">
        <div class="title title--small">{{ saint.name }}</div>
        <div class="label label--small">{{ feastDay }}{% if saint.era %} &middot; {{ saint.era }}{% endif %}</div>
        {% if saint.legacy %}
        <div class="description" data-clamp="2">&ldquo;{{ saint.legacy }}&rdquo;</div>
        {% endif %}
      </div>
    </div>
    {% else %}
    <div class="flex flex--col flex--center-x flex--center-y gap--xsmall grow">
      <div class="description text--center">No saint data</div>
    </div>
    {% endif %}

    <div class="label label--small text--center label--gray">github.com/ACoci86/daily-saints &middot; &copy; 2026 Alessio Coci</div>
  </div>
</div>

<div class="title_bar">
  <span class="title">Saint of the Day</span>
</div>
