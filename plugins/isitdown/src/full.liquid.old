{% comment %}
  Full layout (800x480). Data comes from GET /api/isitdown/status
  ({ services, count, updatedAtLabel }), exposed at the Liquid root by
  TRMNL's polling strategy. Each service has slug/name/status/statusText/
  statusLabelClass/iconUrl/logoUrl/updatedAtLabel (up to 4 services).
  1 service: centered, name above icon, updated_at below.
  2 services: side by side.
  3 services: 2 on the first line, 1 centered on the second.
  4 services: 2x2 grid.
{% endcomment %}
<div class="layout">
  <div class="flex flex--col h--full w--full">
    {% if count == 0 %}
    <div class="flex flex--col flex--center-x flex--center-y gap--medium grow">
      <div class="title title--base text--center">No services configured</div>
      <div class="description text--center">Add up to 4 comma-separated slugs in the plugin settings.</div>
    </div>
    {% elsif count == 1 %}
    <div class="flex flex--col flex--center-x flex--center-y gap--medium grow">
      <div class="title title--large lg:title--xlarge text--center">{{ services[0].name }}</div>
      {% if services[0].logoUrl %}
      <img class="image image--cover image-dither rounded w--24 h--24" src="{{ services[0].logoUrl }}">
      {% endif %}
      <img class="image image--contain image-dither w--64 h--64 lg:w--72 lg:h--72" src="{{ services[0].iconUrl }}">
      {% if services[0].updatedAtLabel %}
      <div class="label label--small text--center label--gray">Updated {{ services[0].updatedAtLabel }}</div>
      {% endif %}
    </div>
    {% elsif count == 2 %}
    <div class="flex flex--row flex--center-x flex--center-y gap--xlarge grow w--full">
      {% for service in services %}
      <div class="flex flex--col flex--center-x flex--center-y gap--xsmall grow">
        <div class="flex flex--row flex--center-x flex--center-y gap--small">
          {% if service.logoUrl %}
          <img class="image image--cover image-dither rounded w--20 h--20" src="{{ service.logoUrl }}">
          {% endif %}
          <div class="label label--base">{{ service.name }}</div>
        </div>
        <img class="image image--contain image-dither w--20 h--20 lg:w--24 lg:h--24" src="{{ service.iconUrl }}">
        {% if service.updatedAtLabel %}
        <div class="label label--small label--gray">Updated {{ service.updatedAtLabel }}</div>
        {% endif %}
      </div>
      {% endfor %}
    </div>
    {% elsif count == 3 %}
    {% assign row1 = services | slice: 0, 2 %}
    {% assign row2 = services | slice: 2, 1 %}
    <div class="flex flex--col flex--center-x flex--center-y gap--large grow">
      <div class="flex flex--row flex--center-x flex--center-y gap--xlarge w--full">
        {% for service in row1 %}
        <div class="flex flex--col flex--center-x flex--center-y gap--xsmall grow">
          <div class="flex flex--row flex--center-x flex--center-y gap--small">
            {% if service.logoUrl %}
            <img class="image image--cover image-dither rounded w--16 h--16" src="{{ service.logoUrl }}">
            {% endif %}
            <div class="label label--base">{{ service.name }}</div>
          </div>
          <img class="image image--contain image-dither w--16 h--16" src="{{ service.iconUrl }}">
          {% if service.updatedAtLabel %}
          <div class="label label--small label--gray">Updated {{ service.updatedAtLabel }}</div>
          {% endif %}
        </div>
        {% endfor %}
      </div>
      <div class="flex flex--row flex--center-x flex--center-y">
        {% for service in row2 %}
        <div class="flex flex--col flex--center-x flex--center-y gap--xsmall">
          <div class="flex flex--row flex--center-x flex--center-y gap--small">
            {% if service.logoUrl %}
            <img class="image image--cover image-dither rounded w--16 h--16" src="{{ service.logoUrl }}">
            {% endif %}
            <div class="label label--base">{{ service.name }}</div>
          </div>
          <img class="image image--contain image-dither w--16 h--16" src="{{ service.iconUrl }}">
          {% if service.updatedAtLabel %}
          <div class="label label--small label--gray">Updated {{ service.updatedAtLabel }}</div>
          {% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
    {% else %}
    {% assign row1 = services | slice: 0, 2 %}
    {% assign row2 = services | slice: 2, 2 %}
    <div class="flex flex--col flex--center-x flex--center-y gap--large grow">
      <div class="flex flex--row flex--center-x flex--center-y gap--xlarge w--full">
        {% for service in row1 %}
        <div class="flex flex--col flex--center-x flex--center-y gap--xsmall grow">
          <div class="flex flex--row flex--center-x flex--center-y gap--small">
            {% if service.logoUrl %}
            <img class="image image--cover image-dither rounded w--16 h--16" src="{{ service.logoUrl }}">
            {% endif %}
            <div class="label label--base">{{ service.name }}</div>
          </div>
          <img class="image image--contain image-dither w--16 h--16" src="{{ service.iconUrl }}">
          {% if service.updatedAtLabel %}
          <div class="label label--small label--gray">Updated {{ service.updatedAtLabel }}</div>
          {% endif %}
        </div>
        {% endfor %}
      </div>
      <div class="flex flex--row flex--center-x flex--center-y gap--xlarge w--full">
        {% for service in row2 %}
        <div class="flex flex--col flex--center-x flex--center-y gap--xsmall grow">
          <div class="flex flex--row flex--center-x flex--center-y gap--small">
            {% if service.logoUrl %}
            <img class="image image--cover image-dither rounded w--16 h--16" src="{{ service.logoUrl }}">
            {% endif %}
            <div class="label label--base">{{ service.name }}</div>
          </div>
          <img class="image image--contain image-dither w--16 h--16" src="{{ service.iconUrl }}">
          {% if service.updatedAtLabel %}
          <div class="label label--small label--gray">Updated {{ service.updatedAtLabel }}</div>
          {% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}
  </div>
</div>

<div class="title_bar">
  <span class="title">IsItDown</span>
  <span class="instance">Updated {{ updatedAtLabel }}</span>
</div>
