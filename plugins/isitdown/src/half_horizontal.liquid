{% comment %}
  Half horizontal layout (800x240). Same data as full.liquid.
  1 service: centered, name above icon, updated_at below.
  2, 3 or 4 services: width divided evenly among them, side by side.
{% endcomment %}
<div class="layout">
  <div class="flex flex--col h--full w--full">
    {% if count == 0 %}
    <div class="flex flex--col flex--center-x flex--center-y gap--small grow">
      <div class="description text--center">No services configured</div>
    </div>
    {% elsif count == 1 %}
    <div class="flex flex--col flex--center-x flex--center-y gap--small grow">
      <div class="title title--base lg:title--large text--center" data-clamp="1">{{ services[0].name }}</div>
      <img class="image image--contain image-dither w--48 h--48 lg:w--56 lg:h--56" src="{{ services[0].iconUrl }}">
      <div class="label label--small text--center label--gray">Updated {{ services[0].updatedAtLabel }}</div>
    </div>
    {% else %}
    <div class="columns gap--large flex--center-y grow">
      {% for service in services %}
      <div class="column flex flex--col flex--center-x flex--center-y gap--small">
        <div class="label label--base text--center" data-clamp="1">{{ service.name }}</div>
        <img class="image image--contain image-dither w--20 h--20 lg:w--24 lg:h--24" src="{{ service.iconUrl }}">
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</div>

<div class="title_bar">
  <span class="title">IsItDown</span>
  <span class="instance">Updated {{ updatedAtLabel }}</span>
</div>
