{% comment %}
  Half horizontal layout (800x240). Same data as full.liquid.
  1 service: centered, name above icon, updated_at below.
  2, 3 or 4 services: width divided evenly among them, side by side.
{% endcomment %}
<div class="layout">
  <div class="flex flex--col h--full w--full">
    {% if count == 0 %}
    <div class="flex flex--col flex--center-x flex--center-y gap--small grow">
      <div class="description text--center">No services configured</div>
    </div>
    {% elsif count == 1 %}
    <div class="flex flex--col flex--center-x flex--center-y gap--small grow">
      <div class="title title--base lg:title--large text--center">{{ services[0].name }}</div>
      {% if services[0].logoUrl %}
      <img class="image image--cover image-dither rounded w--20 h--20" src="{{ services[0].logoUrl }}">
      {% endif %}
      <img class="image image--contain image-dither w--48 h--48 lg:w--56 lg:h--56" src="{{ services[0].iconUrl }}">
      {% if services[0].updatedAtLabel %}
      <div class="label label--small text--center label--gray">Updated {{ services[0].updatedAtLabel }}</div>
      {% endif %}
    </div>
    {% else %}
    <div class="flex flex--row flex--center-x flex--center-y gap--large grow w--full">
      {% for service in services %}
      <div class="flex flex--col flex--center-x flex--center-y gap--xsmall grow">
        <div class="flex flex--row flex--center-x flex--center-y gap--small">
          {% if service.logoUrl %}
          <img class="image image--cover image-dither rounded w--16 h--16" src="{{ service.logoUrl }}">
          {% endif %}
          <div class="label label--base">{{ service.name }}</div>
        </div>
        <img class="image image--contain image-dither w--16 h--16 lg:w--20 lg:h--20" src="{{ service.iconUrl }}">
        {% if service.updatedAtLabel %}
        <div class="label label--small label--gray">Updated {{ service.updatedAtLabel }}</div>
        {% endif %}
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</div>

<div class="title_bar">
  <span class="title">IsItDown</span>
  <span class="instance">Updated {{ updatedAtLabel }}</span>
</div>
