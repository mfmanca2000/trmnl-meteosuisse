{% comment %}
  Half vertical layout (400x480). Same data as full.liquid. Narrow and
  tall, so column count is biased to stay a single stacked column as long
  as reasonable (up to 6 services) before widening to 2 columns.
{% endcomment %}
<div class="layout">
  {% assign n = services.size %}
  {% if services == blank or n == 0 %}
  <div class="flex flex--col flex--center gap--small h--full">
    <span class="title title--base">No services</span>
  </div>
  {% else %}
  {% assign cols = 1 %}
  {% assign icon_size = 'w--28 h--28 lg:w--32 lg:h--32' %}
  {% assign name_class = 'title title--base' %}
  {% assign grid_gap = 'gap--medium' %}
  {% if n <= 3 %}
    {% assign icon_size = 'w--16 h--16' %}
    {% assign name_class = 'label label--base' %}
    {% assign grid_gap = 'gap--small' %}
  {% elsif n <= 6 %}
    {% assign icon_size = 'w--14 h--14' %}
    {% assign name_class = 'label label--base' %}
    {% assign grid_gap = 'gap--small' %}
  {% elsif n <= 9 %}
    {% assign cols = 2 %}
    {% assign icon_size = 'w--12 h--12' %}
    {% assign name_class = 'label label--small' %}
    {% assign grid_gap = 'gap--xsmall' %}
  {% else %}
    {% assign cols = 2 %}
    {% assign icon_size = 'w--10 h--10' %}
    {% assign name_class = 'label label--small' %}
    {% assign grid_gap = 'gap--xsmall' %}
  {% endif %}
  <div class="grid grid--cols-{{ cols }} {{ grid_gap }} h--full">
    {% for service in services limit: 12 %}
    <div class="flex flex--row flex--center gap--xsmall h--full">
      {% if service.logoUrl != blank %}
      <img class="image image--contain image-dither {{ icon_size }} shrink-0" src="{{ service.logoUrl }}">
      {% endif %}
      <span class="{{ name_class }}">{{ service.name }}</span>
      {% if service.iconUrl != blank %}
      <img class="image image--contain image-dither {{ icon_size }} shrink-0" src="{{ service.iconUrl }}">
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">IsItDown</span>
  <span class="instance">{{ services.size }} monitored</span>
</div>
