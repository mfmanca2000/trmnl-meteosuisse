{% comment %}
  Quadrant layout (400x240). Same arrangement as full.liquid, scaled down
  for the tightest space: 1 centered, 2 side by side, 3 as 2+1 centered,
  4 as a 2x2 grid.
{% endcomment %}
<div class="layout">
  <div class="flex flex--col h--full w--full">
    {% if count == 0 %}
    <div class="flex flex--col flex--center-x flex--center-y gap--small grow">
      <div class="description text--center">No services configured</div>
    </div>
    {% elsif count == 1 %}
    <div class="flex flex--col flex--center-x flex--center-y gap--small grow">
      <div class="title title--small lg:title--base text--center" data-clamp="1">{{ services[0].name }}</div>
      <img class="image image--contain image-dither w--32 h--32 lg:w--36 lg:h--36" src="{{ services[0].iconUrl }}">
      <div class="label label--small text--center label--gray">Updated {{ services[0].updatedAtLabel }}</div>
    </div>
    {% elsif count == 2 %}
    <div class="columns gap--medium flex--center-y grow">
      {% for service in services %}
      <div class="column flex flex--col flex--center-x flex--center-y gap--xsmall">
        <div class="label label--small text--center" data-clamp="1">{{ service.name }}</div>
        <img class="image image--contain image-dither w--14 h--14" src="{{ service.iconUrl }}">
      </div>
      {% endfor %}
    </div>
    {% elsif count == 3 %}
    {% assign row1 = services | slice: 0, 2 %}
    {% assign row2 = services | slice: 2, 1 %}
    <div class="flex flex--col flex--center-x flex--center-y gap--small grow">
      <div class="columns gap--medium">
        {% for service in row1 %}
        <div class="column flex flex--col flex--center-x flex--center-y gap--xsmall">
          <div class="label label--small text--center" data-clamp="1">{{ service.name }}</div>
          <img class="image image--contain image-dither w--12 h--12" src="{{ service.iconUrl }}">
        </div>
        {% endfor %}
      </div>
      <div class="flex flex--row flex--center-x">
        {% for service in row2 %}
        <div class="flex flex--col flex--center-x flex--center-y gap--xsmall">
          <div class="label label--small text--center" data-clamp="1">{{ service.name }}</div>
          <img class="image image--contain image-dither w--12 h--12" src="{{ service.iconUrl }}">
        </div>
        {% endfor %}
      </div>
    </div>
    {% else %}
    {% assign row1 = services | slice: 0, 2 %}
    {% assign row2 = services | slice: 2, 2 %}
    <div class="flex flex--col flex--center-x flex--center-y gap--small grow">
      <div class="columns gap--medium">
        {% for service in row1 %}
        <div class="column flex flex--col flex--center-x flex--center-y gap--xsmall">
          <div class="label label--small text--center" data-clamp="1">{{ service.name }}</div>
          <img class="image image--contain image-dither w--10 h--10" src="{{ service.iconUrl }}">
        </div>
        {% endfor %}
      </div>
      <div class="columns gap--medium">
        {% for service in row2 %}
        <div class="column flex flex--col flex--center-x flex--center-y gap--xsmall">
          <div class="label label--small text--center" data-clamp="1">{{ service.name }}</div>
          <img class="image image--contain image-dither w--10 h--10" src="{{ service.iconUrl }}">
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}
  </div>
</div>

<div class="title_bar">
  <span class="title">IsItDown</span>
</div>
