{% comment %}
  Quadrant layout (400x240). Same data and column-count logic as
  full.liquid, scaled down for the tightest space (same aspect ratio as
  full, just a quarter of the area, so sizes shrink faster with n).
{% endcomment %}
<div class="layout">
  {% assign n = services.size %}
  {% if services == blank or n == 0 %}
  <div class="flex flex--col flex--center gap--small h--full">
    <span class="title title--small">No services</span>
  </div>
  {% else %}
  {% assign cols = 1 %}
  {% assign icon_size = 'w--20 h--20 lg:w--24 lg:h--24' %}
  {% assign name_class = 'title title--small' %}
  {% assign row_gap = 'gap--xsmall' %}
  {% assign grid_gap = 'gap--small' %}
  {% if n == 2 or n == 4 %}
    {% assign cols = 2 %}
    {% assign icon_size = 'w--12 h--12' %}
    {% assign name_class = 'label label--small' %}
  {% elsif n == 3 %}
    {% assign cols = 3 %}
    {% assign icon_size = 'w--12 h--12' %}
    {% assign name_class = 'label label--small' %}
  {% elsif n <= 6 %}
    {% assign cols = 3 %}
    {% assign icon_size = 'w--8 h--8' %}
    {% assign name_class = 'label label--small' %}
    {% assign grid_gap = 'gap--xsmall' %}
  {% elsif n <= 8 %}
    {% assign cols = 4 %}
    {% assign icon_size = 'w--6 h--6' %}
    {% assign name_class = 'label label--small' %}
    {% assign grid_gap = 'gap--xsmall' %}
  {% elsif n == 9 %}
    {% assign cols = 3 %}
    {% assign icon_size = 'w--6 h--6' %}
    {% assign name_class = 'label label--small' %}
    {% assign grid_gap = 'gap--xsmall' %}
  {% elsif n == 10 %}
    {% assign cols = 5 %}
    {% assign icon_size = 'w--5 h--5' %}
    {% assign name_class = 'label label--small' %}
    {% assign grid_gap = 'gap--xsmall' %}
  {% else %}
    {% assign cols = 4 %}
    {% assign icon_size = 'w--5 h--5' %}
    {% assign name_class = 'label label--small' %}
    {% assign grid_gap = 'gap--xsmall' %}
  {% endif %}
  <div class="grid grid--cols-{{ cols }} {{ grid_gap }} h--full">
    {% for service in services limit: 12 %}
    <div class="flex flex--row flex--center {{ row_gap }} h--full">
      {% if service.logoUrl != blank %}
      <img class="image image--contain image-dither {{ icon_size }} shrink-0" src="{{ service.logoUrl }}">
      {% endif %}
      <span class="{{ name_class }}">{{ service.name }}</span>
      {% if service.iconUrl != blank %}
      <img class="image image--contain image-dither {{ icon_size }} shrink-0" src="{{ service.iconUrl }}">
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">IsItDown</span>
</div>
