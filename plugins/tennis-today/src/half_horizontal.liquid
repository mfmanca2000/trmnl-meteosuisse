{% comment %}
  Half horizontal layout (800x240). Same card style as full.liquid (two
  stacked, prominent player names + host-country flag on the tournament
  line), trimmed to 2 matches to fit the shorter height.
{% endcomment %}
<div class="layout">
  {% if matches and matches.size > 0 %}
  <div class="flex flex--col flex--center-y gap--small h--full">
    {% for match in matches limit: 2 %}
    {% unless match == blank %}
    <div class="flex flex--col gap--xsmall">
      <div class="flex flex--row flex--center-y gap--small">
        <span class="value value--small lg:value--base grow">{{ match.player1.name }}</span>
        {% if match.isLive %}
        <span class="label label--small label--primary shrink-0">LIVE</span>
        {% elsif match.timeLabel %}
        <span class="label label--small label--outline shrink-0">{{ match.timeLabel }}</span>
        {% else %}
        <span class="label label--small label--gray shrink-0">TBD</span>
        {% endif %}
      </div>
      <div class="flex flex--row flex--center-y gap--small">
        <span class="label label--small label--gray shrink-0">vs</span>
        <span class="value value--small lg:value--base">{{ match.player2.name }}</span>
      </div>
      <div class="flex flex--row flex--center-y gap--xsmall">
        {% if match.tournamentFlagUrl %}
        <img class="image image--cover image-dither rounded shrink-0 w--16 h--12" src="{{ match.tournamentFlagUrl }}">
        {% endif %}
        <span class="label label--small label--gray">{{ match.tournamentName }}{% if match.roundLabel %} &middot; {{ match.roundLabel }}{% endif %}</span>
      </div>
    </div>
    {% endunless %}
    {% endfor %}
  </div>
  {% else %}
  <div class="flex flex--col flex--center-x flex--center-y gap--small h--full">
    <div class="description text--center">No matches today</div>
  </div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">Tennis Today</span>
  <span class="instance">{{ tour | upcase }}{% if count > 2 %} &middot; 2 of {{ count }}{% endif %}</span>
</div>
