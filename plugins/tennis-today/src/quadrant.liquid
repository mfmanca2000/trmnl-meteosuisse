{% comment %}
  Quadrant layout (400x240). Tightest space: 2 matches, stacked player
  names only (no flag/tournament/round/grouping — no room), left aligned,
  each in its own outlined box.

  Each line is a bare <span>, a direct child of the outlined card — no
  per-line wrapper <div>. See half_vertical.liquid's comment: a wrapper
  nested two levels deep inside flex--col columns with no definite-height
  ancestor (no grid here) collapses to near-zero height in this framework.
{% endcomment %}
<div class="layout">
  {% if matches and matches.size > 0 %}
  <div class="flex flex--col flex--left flex--center-y gap--xsmall h--full">
    {% for match in matches limit: 2 %}
    {% unless match == blank %}
    <div class="outline flex flex--col flex--left gap--xsmall p--2 w--full">
      <span class="label label--small">{{ match.player1.name }}</span>
      {% if match.isLive %}
      <span class="label label--small lg:label--base label--primary">LIVE</span>
      {% elsif match.timeLabel %}
      <span class="label label--small lg:label--base label--outline">{{ match.timeLabel }}</span>
      {% endif %}
      <span class="label label--small label--gray">vs</span>
      <span class="label label--small">{{ match.player2.name }}</span>
    </div>
    {% endunless %}
    {% endfor %}
  </div>
  {% else %}
  <div class="flex flex--col flex--center-x flex--center-y gap--xsmall h--full">
    <div class="description text--center">No matches</div>
  </div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">Tennis Today</span>
</div>
