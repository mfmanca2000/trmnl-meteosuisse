{% comment %}
  Full layout (800x480). Shows the commune, current conditions, and an
  8-hour forecast as a list of rows. Data comes from GET /api/forecast
  ({ npa, commune, hourly: [...] }), exposed at the Liquid root by TRMNL's
  polling strategy. hourLabel is precomputed server-side in Europe/Zurich
  time, since Liquid's date filter has no timezone-conversion support.

  Rows use CSS Grid with a fixed column template (not flexbox) so column
  widths never shift with content length: a flex child's "width" is only
  a hint the browser can override when a row runs out of space, which
  made a short condition string like "Rainy" throw off alignment on
  whichever row it landed on. Grid tracks are locked instead.
{% endcomment %}
{% assign cols = "56px 36px minmax(0,1fr) 64px 88px 64px 48px" %}
<div class="layout">
  {% if hourly and hourly.size > 0 %}
  <div class="flex flex--col gap--medium h--full">
    <div class="flex flex--row flex--center-y" style="justify-content: space-between;">
      <div>
        <div class="title title--large" data-clamp="1">{{ commune | default: npa }}</div>
        <div class="label">Hourly forecast</div>
      </div>
      <div class="flex flex--row flex--center-y gap--small">
        <img class="image" src="{{ hourly[0].iconUrl }}" style="width: 56px; height: 56px;">
        <div class="text--right">
          <div class="value value--xlarge value--tnums">{{ hourly[0].temperature | round }}°</div>
          <div class="description">{{ hourly[0].condition | replace: '-', ' ' | capitalize }}</div>
        </div>
      </div>
    </div>

    <div class="divider"></div>

    <div style="display: grid; grid-template-columns: {{ cols }}; column-gap: 8px;">
      <div></div>
      <div></div>
      <div></div>
      <div style="text-align: right;"><span class="label label--small">Temp</span></div>
      <div style="text-align: right;"><span class="label label--small">Min/Max</span></div>
      <div style="text-align: right;"><span class="label label--small">Wind</span></div>
      <div style="text-align: right;"><span class="label label--small">Rain</span></div>
    </div>

    <div class="flex flex--col gap--small" style="flex: 1;">
      {% for hour in hourly limit: 8 %}
      <div style="display: grid; grid-template-columns: {{ cols }}; column-gap: 8px; align-items: center;">
        <span class="label">{{ hour.hourLabel }}</span>
        <img class="image" src="{{ hour.iconUrl }}" style="width: 36px; height: 36px;">
        <span class="description" style="overflow: hidden; white-space: nowrap; text-overflow: ellipsis;">{{ hour.condition | replace: '-', ' ' | capitalize }}</span>
        <span class="value value--medium value--tnums" style="text-align: right;">{{ hour.temperature | round }}°</span>
        <span class="description value--tnums" style="text-align: right;">{{ hour.temperatureMin | round }}° / {{ hour.temperatureMax | round }}°</span>
        <span style="display: flex; align-items: center; justify-content: flex-end; gap: 4px;">
          <span style="display: inline-block; transform: rotate({{ hour.windArrowRotation }}deg);">↑</span>
          <span class="description value--tnums">{{ hour.windSpeed | round }}</span>
        </span>
        <span class="description" style="text-align: right;">{{ hour.precipitationProbability }}%</span>
      </div>
      {% endfor %}
    </div>
  </div>
  {% else %}
  <div class="flex flex--col flex--center-x flex--center-y gap--medium h--full">
    <div class="value value--large">⚙️</div>
    <div class="title title--medium text--center">No forecast data</div>
    <div class="description text--center">Set a Swiss postal code (NPA) in the plugin settings.</div>
  </div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">MeteoSwiss</span>
  <span class="instance">{{ trmnl.plugin_settings.instance_name | default: npa }}</span>
</div>
