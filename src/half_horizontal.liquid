{% comment %}
  Half horizontal layout (800x240). Commune + current conditions on top,
  6-hour forecast as a list of rows below.
{% endcomment %}
<div class="layout">
  {% if hourly and hourly.size > 0 %}
  <div class="flex flex--col gap--small h--full">
    <div class="flex flex--row flex--center-y" style="justify-content: space-between;">
      <div class="title title--medium" data-clamp="1">{{ commune | default: npa }}</div>
      <div class="flex flex--row flex--center-y gap--xsmall">
        <img class="image" src="{{ hourly[0].iconUrl }}" style="width: 32px; height: 32px;">
        <div class="description">{{ hourly[0].condition | replace: '-', ' ' | capitalize }}, {{ hourly[0].temperature | round }}°</div>
      </div>
    </div>

    <div class="divider"></div>

    <div class="flex flex--col gap--xsmall" style="flex: 1;">
      {% for hour in hourly limit: 6 %}
      <div class="flex flex--row flex--center-y gap--medium" style="justify-content: space-between;">
        <div class="label label--small" style="width: 44px;">{{ hour.hourLabel }}</div>
        <img class="image" src="{{ hour.iconUrl }}" style="width: 24px; height: 24px;">
        <div class="description" style="flex: 1;">{{ hour.condition | replace: '-', ' ' | capitalize }}</div>
        <div class="value value--small value--tnums" style="width: 48px; text-align: right;">{{ hour.temperature | round }}°</div>
        <div class="description" style="width: 40px; text-align: right;">{{ hour.precipitationProbability }}%</div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% else %}
  <div class="flex flex--col flex--center-x flex--center-y gap--small h--full">
    <div class="value value--medium">⚙️</div>
    <div class="title title--small text--center">No forecast data</div>
    <div class="description text--center">Set a Swiss postal code (NPA) in the plugin settings.</div>
  </div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">MeteoSwiss</span>
  <span class="instance">{{ trmnl.plugin_settings.instance_name | default: npa }}</span>
</div>
