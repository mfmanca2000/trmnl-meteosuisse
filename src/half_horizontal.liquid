{% comment %}
  Half horizontal layout (800x240). Commune + current conditions on top,
  6-hour forecast as a list of rows below.

  Rows use CSS Grid with a fixed column template (not flexbox) so column
  widths never shift with content length: a flex child's "width" is only
  a hint the browser can override when a row runs out of space, which
  made a short condition string like "Rainy" throw off alignment on
  whichever row it landed on. Grid tracks are locked instead.

  Each row div also needs an explicit width: 100%. Without it, a row
  shrinks to its own content width (driven by how long the condition
  string is) instead of stretching to fill the flex column, and TRMNL's
  renderer then centers the shrunk row, which reintroduces the same
  per-row horizontal drift the grid was meant to fix.
{% endcomment %}
{% assign cols = "44px 24px minmax(0,1fr) 48px 72px 44px 40px" %}
<div class="layout">
  {% if hourly and hourly.size > 0 %}
  <div class="flex flex--col gap--xsmall h--full">
    <div class="flex flex--row flex--center-y" style="justify-content: space-between;">
      <div class="title title--medium" data-clamp="1">{{ commune | default: npa }}</div>
      <div class="flex flex--row flex--center-y gap--xsmall">
        <img class="image" src="{{ hourly[0].iconUrl }}" style="width: 32px; height: 32px;">
        <div class="description">{{ hourly[0].condition | replace: '-', ' ' | capitalize }}, {{ hourly[0].temperature | round }}°</div>
      </div>
    </div>

    <div class="divider"></div>

    <div class="flex flex--col gap--xsmall" style="flex: 1;">
      {% for hour in hourly limit: 6 %}
      <div style="display: grid; grid-template-columns: {{ cols }}; column-gap: 8px; align-items: center; width: 100%;">
        <span class="label label--small">{{ hour.hourLabel }}</span>
        <img class="image" src="{{ hour.iconUrl }}" style="width: 24px; height: 24px;">
        <span class="description" style="overflow: hidden; white-space: nowrap; text-overflow: ellipsis;">{{ hour.condition | replace: '-', ' ' | capitalize }}</span>
        <span class="value value--small value--tnums" style="text-align: right;">{{ hour.temperature | round }}°</span>
        <span class="description value--tnums" style="text-align: right;">{{ hour.temperatureMin | round }}/{{ hour.temperatureMax | round }}°</span>
        <span style="display: flex; align-items: center; justify-content: flex-end; gap: 3px;">
          <span style="display: inline-block; transform: rotate({{ hour.windArrowRotation }}deg);">↑</span>
          <span class="description value--tnums">{{ hour.windSpeed | round }}</span>
        </span>
        <span class="description" style="text-align: right;">{{ hour.precipitationProbability }}%</span>
      </div>
      {% endfor %}
    </div>
  </div>
  {% else %}
  <div class="flex flex--col flex--center-x flex--center-y gap--small h--full">
    <div class="value value--medium">⚙️</div>
    <div class="title title--small text--center">No forecast data</div>
    <div class="description text--center">Set a Swiss postal code (NPA) in the plugin settings.</div>
  </div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">MeteoSwiss</span>
  <span class="instance">{{ trmnl.plugin_settings.instance_name | default: npa }}</span>
</div>
