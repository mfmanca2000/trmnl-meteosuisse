{% comment %}
  Half vertical layout (400x480). Commune name up top, hourly forecast as a
  scannable list of rows (narrow width fits a list better than a wide grid).
  hourLabel is precomputed server-side in Europe/Zurich time, since
  Liquid's date filter has no timezone-conversion support.
{% endcomment %}
<div class="layout">
  {% if hourly and hourly.size > 0 %}
  <div class="flex flex--col gap--small h--full">
    <div class="text--center">
      <div class="title title--medium" data-clamp="1">{{ commune | default: npa }}</div>
      <div class="label">Hourly forecast</div>
    </div>

    <div class="divider"></div>

    <div class="flex flex--col gap--small" style="flex: 1;">
      {% for hour in hourly limit: 7 %}
      <div class="flex flex--row flex--center-y gap--small">
        <div style="width: 48px;"><span class="label">{{ hour.hourLabel }}</span></div>
        <img class="image" src="{{ hour.iconUrl }}" style="width: 28px; height: 28px;">
        <div style="flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;"><span class="description">{{ hour.condition | replace: '-', ' ' | capitalize }}</span></div>
        <div style="width: 44px; text-align: right;"><span class="value value--small value--tnums">{{ hour.temperature | round }}°</span></div>
        <div style="width: 40px; display: flex; align-items: center; justify-content: flex-end; gap: 3px;">
          <span style="display: inline-block; transform: rotate({{ hour.windArrowRotation }}deg);">↑</span>
          <span class="description value--tnums">{{ hour.windSpeed | round }}</span>
        </div>
        <div style="width: 36px; text-align: right;"><span class="description">{{ hour.precipitationProbability }}%</span></div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% else %}
  <div class="flex flex--col flex--center-x flex--center-y gap--small h--full">
    <div class="value value--medium">⚙️</div>
    <div class="title title--small text--center">No forecast data</div>
    <div class="description text--center">Set a Swiss postal code (NPA) in the plugin settings.</div>
  </div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">MeteoSwiss</span>
  <span class="instance">{{ trmnl.plugin_settings.instance_name | default: npa }}</span>
</div>
