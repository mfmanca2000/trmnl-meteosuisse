{% comment %}
  Quadrant layout (400x240). Tightest space: commune + current temp on top,
  a compact 4-hour list of rows below.

  Rows use CSS Grid with a fixed column template (not flexbox) so column
  widths never shift with content length: a flex child's "width" is only
  a hint the browser can override when a row runs out of space, which
  made a short condition string like "Rainy" throw off alignment on
  whichever row it landed on. Grid tracks are locked instead.

  Each row div also needs an explicit width: 100%. Without it, a row
  shrinks to its own content width (driven by how long the condition
  string is) instead of stretching to fill the flex column, and TRMNL's
  renderer then centers the shrunk row, which reintroduces the same
  per-row horizontal drift the grid was meant to fix.
{% endcomment %}
{% assign cols = "36px 20px minmax(0,1fr) 36px" %}
<div class="layout">
  {% if hourly and hourly.size > 0 %}
  <div class="flex flex--col gap--xsmall h--full">
    <div class="flex flex--row flex--center-y" style="justify-content: space-between;">
      <div class="title title--small" data-clamp="1">{{ commune | default: npa }}</div>
      <div class="value value--small value--tnums">{{ hourly[0].temperature | round }}°</div>
    </div>

    <div class="flex flex--col gap--xsmall" style="flex: 1;">
      {% for hour in hourly limit: 4 %}
      <div style="display: grid; grid-template-columns: {{ cols }}; column-gap: 6px; align-items: center; width: 100%;">
        <span class="label label--small">{{ hour.hourLabel }}</span>
        <img class="image" src="{{ hour.iconUrl }}" style="width: 20px; height: 20px;">
        <span class="description" style="overflow: hidden; white-space: nowrap; text-overflow: ellipsis;">{{ hour.condition | replace: '-', ' ' | capitalize }}</span>
        <span class="description value--tnums" style="text-align: right;">{{ hour.temperature | round }}°</span>
      </div>
      {% endfor %}
    </div>
  </div>
  {% else %}
  <div class="flex flex--col flex--center-x flex--center-y gap--xsmall h--full">
    <div class="value value--small">⚙️</div>
    <div class="description text--center">Set an NPA in plugin settings.</div>
  </div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">MeteoSwiss</span>
</div>
